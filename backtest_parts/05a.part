            sensitivity_rows.append({"volume_multiplier": mult, "ema_reset_each_session": reset, **{k: s.get(k) for k in ["trades", "trades_per_5_session_week", "win_rate", "average_r", "profit_factor", "total_r", "max_drawdown_r"]}})
