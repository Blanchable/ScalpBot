    ci = fixed.get("bootstrap_mean_r_95pct", [None, None])
    enough = fixed.get("trades", 0) >= 100
    positive = fixed.get("average_r", -999) > 0 and (fixed.get("profit_factor") or 0) > 1
    robust = ci[0] is not None and ci[0] > 0 and fixed.get("last_40pct_average_r", -999) > 0
    if enough and positive and robust:
        verdict = "PROMISING_UNDERLYING_SIGNAL__PROCEED_TO_OPTIONS_BACKTEST"
