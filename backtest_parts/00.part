#!/usr/bin/env python3
"""Backtest the frozen SPY 5-minute 20-EMA, volume, and price-action rules.

This tests the SPY underlying signal only. It does not model option contract prices,
bid/ask spreads, Greeks, implied volatility, or option fills.
"""
from __future__ import annotations

import json
import math
import os
from dataclasses import asdict, dataclass, replace
from datetime import time
from pathlib import Path
from typing import Optional

import numpy as np
import pandas as pd

DATA_URL = "https://raw.githubusercontent.com/vivek-v-rao/Intraday-Vol/refs/heads/main/SPY.csv"
OUT = Path(os.environ.get("BACKTEST_OUT", "results"))


@dataclass(frozen=True)
class Config:
    ema_period: int = 20
    ema_slope_lookback: int = 3
    volume_lookback: int = 6
    volume_multiplier: float = 1.25
    ema_approach_pct: float = 0.0010
    material_close_tolerance_pct: float = 0.0005
    entry_buffer: float = 0.01
    stop_buffer: float = 0.02
    min_risk_pct: float = 0.0010
    max_risk_pct: float = 0.0040
    target_r: float = 1.5
    pending_bars: int = 2
    max_entries_per_day: int = 3
    max_losses_per_day: int = 2
    cooldown_bars: int = 3
    breakeven_after_r: Optional[float] = None
    ema_reset_each_session: bool = False


def allowed(ts: pd.Timestamp) -> bool:
    t = ts.time()
    return time(10, 0) <= t < time(11, 30) or time(13, 30) <= t < time(15, 0)


def segment(ts: pd.Timestamp) -> str:
    return "morning" if ts.time() < time(11, 30) else "afternoon"


def load_data() -> tuple[pd.DataFrame, dict, pd.DataFrame]:
    raw = pd.read_csv(DATA_URL)
    need = ["Datetime", "Open", "High", "Low", "Close", "Volume"]
    missing = [c for c in need if c not in raw.columns]
    if missing:
        raise ValueError(f"Missing required columns: {missing}")

    raw["timestamp"] = pd.to_datetime(raw["Datetime"], utc=True, errors="coerce").dt.tz_convert("America/New_York")
    for c in ["Open", "High", "Low", "Close", "Volume"]:
        raw[c] = pd.to_numeric(raw[c], errors="coerce")

    quality = {
        "data_url": DATA_URL,
        "raw_rows": int(len(raw)),
        "duplicate_timestamps": int(raw["timestamp"].duplicated().sum()),
        "null_required_rows": int(raw[["timestamp", "Open", "High", "Low", "Close", "Volume"]].isna().any(axis=1).sum()),
    }

    valid = (
        raw["timestamp"].notna()
        & (raw[["Open", "High", "Low", "Close"]] > 0).all(axis=1)
        & (raw["Volume"] > 0)
        & (raw["High"] >= raw[["Open", "Close", "Low"]].max(axis=1))
        & (raw["Low"] <= raw[["Open", "Close", "High"]].min(axis=1))
    )
    quality["invalid_rows"] = int((~valid).sum())
    frame = raw.loc[valid, ["timestamp", "Open", "High", "Low", "Close", "Volume"]].copy()
    frame = frame.drop_duplicates("timestamp").sort_values("timestamp").reset_index(drop=True)
    frame["date"] = frame["timestamp"].dt.date
    frame["clock"] = frame["timestamp"].dt.time
    frame = frame[(frame["clock"] >= time(9, 30)) & (frame["clock"] <= time(15, 55))].copy()

    expected = set(pd.date_range("2000-01-03 09:30", "2000-01-03 15:55", freq="5min").time)
    rows = []
    complete_dates = []
    for d, g in frame.groupby("date", sort=True):
        clocks = set(g["clock"])
        complete = len(g) == 78 and clocks == expected
        rows.append({"date": str(d), "bars": int(len(g)), "complete": bool(complete), "first": str(g["clock"].min()), "last": str(g["clock"].max())})
        if complete:
            complete_dates.append(d)

    sessions = pd.DataFrame(rows)
    frame = frame[frame["date"].isin(complete_dates)].sort_values("timestamp").reset_index(drop=True)
    quality.update({
        "sessions_seen": int(len(sessions)),
        "complete_sessions": int(len(complete_dates)),
        "excluded_sessions": int((~sessions["complete"]).sum()),
        "clean_rows": int(len(frame)),
        "first_timestamp": str(frame["timestamp"].min()),
        "last_timestamp": str(frame["timestamp"].max()),
    })
    if frame.empty:
        raise RuntimeError("No complete regular sessions remained after validation")
    return frame